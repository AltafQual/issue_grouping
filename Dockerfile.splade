FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_SYSTEM_PYTHON=1 \
    HF_HOME=/app/.hf_cache

# Note: PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True is NOT set here —
# the underlying cuMemMap ops require driver >= 525 and on older drivers the
# allocator's first call returns `cudaErrorNotSupported`. If you have a recent
# driver and want the expandable-segments allocator, set the env var on the
# host before `make splade-up` (compose forwards it).

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock* ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen

COPY . .

ENV PATH="/app/.venv/bin:${PATH}"
EXPOSE 8000

# Run uvicorn directly — NOT under gunicorn. Gunicorn's master forks the
# worker, and CUDA contexts / virtual-memory allocations don't always survive
# fork() on every driver/profile (notably vGPU partitions like GRID A100D-*),
# manifesting as `cudaErrorNotSupported` on the first GPU op inside the
# worker. Uvicorn's `--limit-max-requests` gives equivalent RSS-bounding;
# combined with `restart: unless-stopped` in compose, the container recycles
# on its own.
CMD ["uvicorn", "splade_api:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--limit-max-requests", "200", \
     "--timeout-keep-alive", "30"]
